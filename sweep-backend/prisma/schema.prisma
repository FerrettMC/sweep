generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id
  email        String   @unique
  // Public display name on the leaderboard. Null until the user picks one, in
  // which case they show as an anonymous "Sweeper #abcd" — a leaderboard must
  // never expose email addresses.
  username     String?  @unique
  createdAt    DateTime @default(now())

  wallet            Wallet?
  trackedProducts   TrackedProduct[]
  transactions      Transaction[]
  budgetEntries     BudgetEntry[]
  budgetLimits      BudgetLimit[]
  savedSearches     SavedSearch[]
  promoRedemptions  PromoCodeRedemption[]
  pushTokens        PushToken[]
  dealsFound        Deal[]   @relation("DealFinder")
  lists             List[]
}

// One row per device a user has granted notification permission on. A user can
// have several (phone + tablet), and a token can migrate between users if a
// device is handed over — hence the unique on token rather than on userId.
model PushToken {
  id         String   @id @default(uuid())
  token      String   @unique // ExponentPushToken[...]
  platform   String?  // "ios" | "android"
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
}

model Wallet {
  id                String    @id @default(uuid())
  tier              String    @default("free") // "free" | "pro" | "ultimate"
  tierExpiresAt     DateTime?
  xp                Int       @default(0)
  searchesUsedToday Int       @default(0)
  // Extra searches unlocked today by watching rewarded ads, on top of the
  // tier's base allowance. Resets on the same daily boundary.
  bonusSearchesToday Int      @default(0)
  searchesResetAt   DateTime  @default(now())

  // Fixed times of day this user's products are checked, as local hours (0-23).
  // Free tier picks 2 — that's what bounds scraping load predictably instead of
  // it scaling with signups. Pro/Ultimate ignore this and use a rolling
  // interval instead.
  // Manual "Check price now" budget. Free gets a daily count, Pro a cooldown
  // between checks, Ultimate neither — see TIER_LIMITS.
  manualChecksToday Int       @default(0)
  manualChecksResetAt DateTime @default(now())
  lastManualCheckAt DateTime?

  // "Sweep this deal" — the cross-retailer verdict. Metered separately from
  // search because one sweep fans out to every retailer AND re-reads history,
  // so it costs more than a search and is priced to match.
  sweepsUsedToday   Int       @default(0)
  sweepsResetAt     DateTime  @default(now())

  // Manual "check my radars now" budget. This is what makes the free tier's
  // radar bounded: nothing runs unless someone taps, and they can only tap so
  // many times a day.
  radarRefreshesToday Int      @default(0)
  radarRefreshesResetAt DateTime @default(now())

  checkHours        Int[]     @default([9, 21])
  // Minute offset for the interval tiers, anchored to local midnight.
  // Pro (every 2h) with 35 => 00:35, 02:35, 04:35…
  // Ultimate (every 30m) with 5 => 00:05, 00:35, 01:05…
  checkMinute       Int       @default(0)
  // IANA zone, so "9am" means 9am where the user is, and survives DST. Stored
  // rather than an offset because an offset goes stale twice a year.
  timezone          String    @default("UTC")
  updatedAt         DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique
}

// One row per unique product being tracked ANYWHERE in the app — shared
// across all users tracking the same item, so a single check refreshes
// the price for everyone at once (same principle as Fervor's odds polling).
model Product {
  id            String    @id @default(uuid())
  retailer      String    // "amazon" | "walmart" | "target" | "bestbuy" | "ebay"
  retailerId    String    // ASIN / item ID / SKU — however that retailer identifies it
  url           String
  title         String
  imageUrl      String?
  currentPrice  Int?      // cents, null if not yet checked
  listPrice     Int?      // cents — retailer's "was"/list price, when shown
  currency      String    @default("USD")
  availability  String?   // free-text from the retailer, normalized where possible
  rating        Float?
  ratingCount   Int?
  lastCheckedAt DateTime?
  // Outcome of the most recent check. Mirrors ScrapeCheck.status but kept here
  // so a stale/blocked product can be filtered without joining the log.
  lastStatus    String?   // "success" | "failed" | "blocked"
  // Consecutive checks that came back at the same price. Drives adaptive
  // backoff: an item that hasn't moved in weeks doesn't need checking as often
  // as one that's actively changing. Lives on Product, not TrackedProduct,
  // because checks are shared — if it's stable, it's stable for everyone.
  unchangedChecks Int     @default(0)
  createdAt     DateTime  @default(now())

  priceHistory  PriceHistory[]
  trackedBy     TrackedProduct[]
  scrapeChecks  ScrapeCheck[]
  deals         Deal[]
  listItems     ListItem[]
  budgetEntries BudgetEntry[]

  @@unique([retailer, retailerId])
  @@index([retailer])
  // Drives the scheduler's "who is due for a check" query.
  @@index([lastCheckedAt])
}

model PriceHistory {
  id        String   @id @default(uuid())
  price     Int      // cents
  checkedAt DateTime @default(now())

  product   Product @relation(fields: [productId], references: [id])
  productId String

  @@index([productId, checkedAt])
}

// Join between a user and a product they're tracking — per-user settings
// (custom threshold, notification state) live here, not on Product.
model TrackedProduct {
  id              String    @id @default(uuid())
  customThreshold Int?      // cents — only notify below this (Pro and above)
  addedAt         DateTime  @default(now())
  lastNotifiedAt  DateTime?
  // What it cost when this user started watching, in cents. Stored rather than
  // derived: the shared Product row is updated in place, and PriceHistory only
  // records CHANGES — so a product that never moved has no history point at
  // the moment this user started, and "since you started" would be unanswerable.
  priceAtTracking Int?

  user      User    @relation(fields: [userId], references: [id])
  userId    String
  product   Product @relation(fields: [productId], references: [id])
  productId String

  @@unique([userId, productId])
  @@index([userId])
}

// Every price-check attempt writes one row here, success or not. This is the
// raw material for scraper health monitoring — a retailer changing its page
// structure shows up as a failure-rate spike, not as silent staleness.
model ScrapeCheck {
  id        String   @id @default(uuid())
  retailer  String
  status    String   // "success" | "failed" | "blocked"
  // Truncated response body or error message, kept so the alert email can show
  // WHY it broke (structure change vs. actively blocked vs. timeout) without
  // needing to re-run the scrape to find out.
  detail    String?
  durationMs Int?
  checkedAt DateTime @default(now())

  product   Product? @relation(fields: [productId], references: [id])
  productId String?

  @@index([retailer, checkedAt])
}

// Tracks when we last alerted about a given retailer, so a sustained outage
// sends one email instead of one per failed check.
model ScraperAlert {
  id          String   @id @default(uuid())
  retailer    String   @unique
  lastAlertAt DateTime @default(now())
  resolvedAt  DateTime?
}

// Guests have no User row, so their 1-search-per-day cap is keyed by a device
// ID generated on the client. Server-side so the client can't reset it by
// clearing state — reinstalling gets you one more search, and that's an
// acceptable ceiling for a free anonymous tier.
model GuestQuota {
  id                String   @id @default(uuid())
  deviceId          String   @unique
  searchesUsedToday Int      @default(0)
  searchesResetAt   DateTime @default(now())
  createdAt         DateTime @default(now())
}

// One row per verified rewarded-ad completion. Exists purely to stop replays:
// AdMob can retry a callback, and without a uniqueness check on transactionId
// the same ad view could be redeemed repeatedly for free searches.
model AdReward {
  id            String   @id @default(uuid())
  transactionId String   @unique
  userId        String
  amount        Int      @default(1)
  createdAt     DateTime @default(now())

  @@index([userId])
}

// A price drop good enough to show the whole app. Written by the scheduler
// when a tracked item falls far enough below its own historical average.
//
// `finderUserId` is whoever tracked the product FIRST — with the shared cache,
// many people watch the same item, and the one who spotted it before everyone
// else is the one worth crediting.
model Deal {
  id                  String   @id @default(uuid())
  previousPrice       Int      // cents
  newPrice            Int      // cents
  percentBelowAverage Int
  averagePrice        Int      // cents, what "normal" was at the time
  createdAt           DateTime @default(now())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  // Nullable so a deal survives its finder deleting their account.
  finder       User?   @relation("DealFinder", fields: [finderUserId], references: [id], onDelete: SetNull)
  finderUserId String?

  @@index([createdAt])
  @@index([productId, createdAt])
}

// A gift list or wishlist. Shareable by public link — that's the growth loop:
// every shared list puts Sweep in front of someone who's never heard of it.
model List {
  id          String   @id @default(uuid())
  name        String
  description String?
  // Random, unguessable, and separate from the id so a list can be unshared by
  // rotating it without breaking the list itself.
  shareToken  String?  @unique
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  items ListItem[]

  @@index([userId])
}

// A product on a list. Note this does NOT imply the product is price-tracked:
// list items are capped separately precisely because every tracked item costs
// real scraping, and a 100-item wishlist shouldn't quietly become 100 tracked
// products.
model ListItem {
  id        String   @id @default(uuid())
  note      String?
  addedAt   DateTime @default(now())
  // Marked off by the list owner, or by whoever they shared it with.
  claimed   Boolean  @default(false)

  list      List    @relation(fields: [listId], references: [id], onDelete: Cascade)
  listId    String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@unique([listId, productId])
  @@index([listId])
}

model BudgetEntry {
  id          String   @id @default(uuid())
  amount      Int      // cents
  category    String
  description String?
  spentAt     DateTime @default(now())
  createdAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  // Set when the entry came from "I bought this" on a tracked product, which
  // is what makes this a shopping budget rather than a generic one: the row
  // remembers the item, so spending can be traced back to a real product.
  // SetNull rather than Cascade — deleting a cached product must never erase
  // someone's spending record.
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId String?

  @@index([userId, spentAt])
}

// A spending cap. An empty `category` is the overall monthly budget, which
// every tier gets; a named category is a per-category cap, which is a paid
// perk. The API speaks `null` for overall and converts at the edge.
//
// Empty string rather than NULL on purpose: Postgres treats NULLs as distinct
// in a unique index, so `@@unique([userId, category])` would happily allow two
// overall budgets per user. A sentinel makes the constraint actually hold.
//
// Deliberately not per-month rows: a budget is a standing intention, not a
// value you re-enter every month. Changing it changes it going forward.
// A standing "tell me when anything matches this" search.
//
// Tracking watches a URL you already found; a radar watches for something you
// haven't. That's the gap it fills, and it's why the keyword matters more than
// any particular listing.
//
// Deliberately stores the cheapest match we've already reported. Without it,
// every run re-reports the same $179 listing forever and the alerts become
// noise people turn off.
model SavedSearch {
  id          String   @id @default(uuid())
  keyword     String
  /** Cents. Null means "tell me about anything notable", not "never alert". */
  targetPrice Int?
  createdAt   DateTime @default(now())

  lastCheckedAt DateTime?
  nextCheckAt   DateTime  @default(now())
  /** Feeds the same adaptive backoff that tracked products use. */
  unchangedChecks Int @default(0)

  /** Cheapest price we've already told this user about, so we don't repeat it. */
  lastBestPrice Int?
  lastMatchAt   DateTime?
  lastNotifiedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
  @@index([nextCheckAt])
}

model BudgetLimit {
  id        String   @id @default(uuid())
  amount    Int      // cents
  category  String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([userId, category])
}

// XP ledger. Every award is a row, so a user's total is reconstructible and
// an anti-farming cooldown is just a query against recent rows rather than
// extra state to keep in sync.
model Transaction {
  id        String   @id @default(uuid())
  xpChange  Int
  reason    String   // "deal_found" | "first_track" | "milestone"
  // Which product earned it, when applicable. Drives the per-product cooldown
  // that stops someone farming XP off one item bouncing in price.
  productId String?
  // Human-readable detail for the activity feed ("32% below average").
  detail    String?
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@index([userId])
  @@index([userId, productId, createdAt])
  @@index([createdAt])
}

// Promo codes YOU create and share (e.g. while creating content) — one
// directional: you issue it, someone redeems it for free Pro/Ultimate time.
model PromoCode {
  id                 String    @id @default(uuid())
  code               String    @unique
  grantsTier         String    // "pro" | "ultimate"
  grantsDurationDays Int       // e.g. 7 for a week free
  maxRedemptions     Int?      // null = unlimited
  timesRedeemed      Int       @default(0)
  expiresAt          DateTime? // code itself stops working after this date, if set
  createdAt          DateTime  @default(now())

  redemptions PromoCodeRedemption[]
}

model PromoCodeRedemption {
  id          String   @id @default(uuid())
  redeemedAt  DateTime @default(now())

  user        User      @relation(fields: [userId], references: [id])
  userId      String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])
  promoCodeId String

  @@unique([userId, promoCodeId]) // can't redeem the same code twice
}